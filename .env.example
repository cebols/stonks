# ----------------------------------------------------------------------------
# Supabase
# ----------------------------------------------------------------------------
# Public (browser-safe) — usado pelo frontend (Next.js). Apenas leitura via RLS.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role (NUNCA expor no browser) — usado só pelos scripts de ingestão
# e pela GitHub Action. Tem permissão de escrita, ignora RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ----------------------------------------------------------------------------
# Fonte de dados: JSON combinado (Câmara + Senado) já normalizado, derivado
# dos filings oficiais do STOCK Act. Aceita lista separada por vírgula.
# ----------------------------------------------------------------------------
TRADES_URL=https://raw.githubusercontent.com/kadoa-org/congress-trading-monitor/main/public/data/trades.json

# ----------------------------------------------------------------------------
# Preços históricos (gratuito, sem chave): Stooq.
# Endpoint usado: https://stooq.com/q/d/l/?s={TICKER}.US&i=d
# ----------------------------------------------------------------------------
PRICE_BENCHMARK_TICKER=SPY
