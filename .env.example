# ----------------------------------------------------------------------------
# Supabase
# ----------------------------------------------------------------------------
# Public (browser-safe) — usado pelo frontend (Next.js). Apenas leitura via RLS.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role (NUNCA expor no browser) — usado só pelos scripts de ingestão
# e pela GitHub Action. Tem permissão de escrita, ignora RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ----------------------------------------------------------------------------
# Fontes de dados (JSON público já normalizado). Verifique os caminhos antes
# de rodar — repositórios podem mudar a estrutura de pastas.
# ----------------------------------------------------------------------------
SENATE_TRADES_URL=https://raw.githubusercontent.com/timothycarambat/senate-stock-watcher-data/master/aggregate/all_transactions.json
HOUSE_TRADES_URL=https://raw.githubusercontent.com/pastrosd/Congress-Trades/main/House.json

# ----------------------------------------------------------------------------
# Preços históricos (gratuito, sem chave): Stooq.
# Endpoint usado: https://stooq.com/q/d/l/?s={TICKER}.US&i=d
# ----------------------------------------------------------------------------
PRICE_BENCHMARK_TICKER=SPY
